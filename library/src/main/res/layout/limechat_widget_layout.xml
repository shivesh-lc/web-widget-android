<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageButton
        android:id="@+id/limechat_floating_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/limechat_circle_background"
        android:src="@drawable/ic_limechat_chat"
        android:scaleType="centerInside"
        android:padding="14dp"
        android:elevation="6dp"
        android:stateListAnimator="@animator/limechat_button_animator"
        android:contentDescription="@string/limechat_open_chat" />

    <TextView
        android:id="@+id/limechat_unread_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="20dp"
        android:minHeight="20dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:background="@drawable/limechat_badge_background"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:elevation="8dp"
        android:visibility="gone" />

</FrameLayout>